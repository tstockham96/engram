{
  "name": "engram-sdk",
  "mcpName": "io.github.tstockham96/engram",
  "version": "0.7.1",
  "description": "Semantic memory with knowledge graphs, consolidation, and spreading activation for AI agents. 80% LOCOMO accuracy vs 28.8% for file-based memory. MCP server included.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "bin": {
    "engram": "dist/cli.js",
    "engram-serve": "dist/server.js",
    "engram-mcp": "dist/mcp.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "cli": "tsx src/cli.ts",
    "serve": "tsx src/server.ts",
    "mcp": "tsx src/mcp.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "ai",
    "agents",
    "memory",
    "llm",
    "rag",
    "mcp",
    "claude",
    "claude-code",
    "cursor",
    "persistent-memory",
    "knowledge-graph",
    "vector-search",
    "embeddings",
    "consolidation",
    "context-window",
    "agent-memory",
    "semantic-memory",
    "sqlite",
    "engram"
  ],
  "author": "Thomas Stockham",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tstockham96/engram"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "js-yaml": "^4.3.2",
    "sqlite-vec": "^0.1.9",
    "uuid": "^11.1.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.12.0",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
